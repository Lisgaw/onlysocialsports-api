# Sports Partner API — Environment Variables
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.

# ─── Supabase ────────────────────────────────────────────────────
# Supabase Dashboard → Settings → API → URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Dashboard → Settings → API → service_role key (secret!)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── JWT ─────────────────────────────────────────────────────────
# Minimum 32 karakter, rastgele string
JWT_SECRET=your-very-secret-jwt-key-change-this-in-production

# ─── Server ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── CORS Security ───────────────────────────────────────────────
# Comma-separated allowlist. Supports wildcard patterns, e.g. https://*.vercel.app
CORS_ALLOWED_ORIGINS=https://onlysocialsport.com,https://www.onlysocialsport.com,https://api.onlysocialsport.com,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Emergency switch (avoid in production)
CORS_ALLOW_ALL=false

# ─── Password Reset Mail (SMTP) ───────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=mailer@example.com
SMTP_FROM_NAME=SporPartner

# Web reset sayfası URL'i (opsiyonel, link e-postaya eklenir)
PASSWORD_RESET_URL=https://onlysocialsport.com/web/#/reset-password

# Password reset güvenlik ayarları (opsiyonel)
PASSWORD_RESET_CODE_TTL_MINUTES=15
PASSWORD_RESET_MIN_PASSWORD_LENGTH=8
PASSWORD_RESET_RATE_WINDOW_MS=900000
PASSWORD_RESET_MAX_PER_IP=20
PASSWORD_RESET_MAX_PER_EMAIL=5
PASSWORD_RESET_VERIFY_MAX_PER_IP=25
PASSWORD_RESET_VERIFY_MAX_PER_TOKEN=10

# ─── Vercel (otomatik set edilir) ─────────────────────────────────
# VERCEL=1
# VERCEL_ENV=production
